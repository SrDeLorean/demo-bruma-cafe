---
import { site } from '../data/site';
---

<header class="hero">
  <div class="hero-copy">
    <h1>{site.name}</h1>
    <p id="propuesta" class="proposal">{site.proposal}</p>
    <a class="menu-link" href="#carta">Ver la carta</a>
  </div>
  <svg class="cup" viewBox="0 0 320 340" aria-hidden="true" focusable="false" fill="none">
    <path class="steam" d="M115 133c-42-39 51-48 8-91M162 132c-42-39 51-48 8-91M209 133c-42-39 51-48 8-91" />
    <path d="M65 166h170v52a85 85 0 0 1-170 0v-52Z" />
    <path d="M235 177h17a31 31 0 0 1 0 62h-19M48 307h204" />
    <path class="coffee" d="M84 185h132" />
  </svg>
</header>
