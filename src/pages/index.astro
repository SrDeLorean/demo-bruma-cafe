---
import Base from '../layouts/Base.astro';
import DemoNotice from '../components/DemoNotice.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
---

<Base>
  <DemoNotice />
  <main id="contenido" class="page" tabindex="-1">
    <Hero />
    <section id="carta" class="menu-section" tabindex="-1" aria-labelledby="carta-titulo">
      <h2 id="carta-titulo">{site.menu.heading}</h2>
      <p>{site.menu.pending}</p>
    </section>
  </main>
  <footer class="page footer">
    <p>Una cafetería imaginada para un proyecto de portafolio.</p>
    <a href={site.repository}>Ver el código en GitHub</a>
  </footer>
</Base>
